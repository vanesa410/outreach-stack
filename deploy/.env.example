# Copy this to `.env` and fill in your own values. NEVER commit the real .env.
# Generate secrets with:  openssl rand -base64 32   (and  openssl rand -hex 24)

# ── Image versions ───────────────────────────────────────────────────────────
TWENTY_TAG=latest
N8N_TAG=latest

# ── Postgres (shared by Twenty + n8n + Stalwart) ─────────────────────────────
PG_USER=postgres
PG_PASSWORD=CHANGE_ME_strong_password_no_special_chars

# ── Twenty CRM ───────────────────────────────────────────────────────────────
TWENTY_SERVER_URL=https://crm.example.com        # local: http://localhost:3100
TWENTY_APP_SECRET=CHANGE_ME_openssl_rand_base64_32
TWENTY_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32

# ── n8n ──────────────────────────────────────────────────────────────────────
N8N_HOST=n8n.example.com                          # local: localhost
N8N_WEBHOOK_URL=https://n8n.example.com/          # local: http://localhost:5678/
N8N_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_24
TZ=Europe/Prague

# ── Stalwart mail server (optional; for self-hosted receiving — see GO-LIVE.md) ─
STALWART_ADMIN_PASSWORD=CHANGE_ME_openssl_rand_hex_16

# ── Twenty native Gmail sync (optional; only if you connect Gmail inside Twenty)─
AUTH_GOOGLE_ENABLED=false
MESSAGING_PROVIDER_GMAIL_ENABLED=false
CALENDAR_PROVIDER_GOOGLE_ENABLED=false
TWENTY_GOOGLE_CLIENT_ID=
TWENTY_GOOGLE_CLIENT_SECRET=
TWENTY_GOOGLE_CALLBACK_URL=
TWENTY_GOOGLE_APIS_CALLBACK_URL=
